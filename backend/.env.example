PROJECT_NAME="RescuAI Emergency API"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-super-secret-key-for-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (SQLite default for easy local testing, PostgreSQL for prod)
DATABASE_URL="sqlite:///./rescuai.db"
# For PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/rescuai_db"

# Google Gemini API Key
GEMINI_API_KEY="your-gemini-api-key-here"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
